# Copy to .env and fill in real values. .env is gitignored; this file is not.
# SRS section 7: the JWT secret must never live in source control.

# development | test | production
APP_ENV=development

# SQLite by default. Swap for e.g. postgresql+psycopg://user:pass@host/db later.
DATABASE_URL=sqlite:///./expense_tracker.db

# REQUIRED outside development. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start if this is left at the placeholder while APP_ENV != development.
JWT_SECRET_KEY=change-me-this-is-not-a-real-secret

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password-reset OTP
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Local testing only: echoes the OTP in the API response instead of only the log.
# Forced off when APP_ENV=production.
EXPOSE_OTP_IN_RESPONSE=false

BCRYPT_ROUNDS=12
LOG_LEVEL=INFO

# JSON array of allowed frontend origins for CORS.
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Chatbot endpoint (LangGraph agent). Required for /chatbot/queries to reach a
# real model; the app still starts without it.
OPENAI_API_KEY=
CHATBOT_MODEL=gpt-5
